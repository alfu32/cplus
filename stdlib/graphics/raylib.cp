#ifndef CPLUS_STDLIB_GRAPHICS_RAYLIB_CP
#define CPLUS_STDLIB_GRAPHICS_RAYLIB_CP

/* Umbrella import for Raylib domains; all declarations remain native Raylib C. */
comptime import "stdlib:/graphics/raylib/core.cp";
comptime import "stdlib:/graphics/raylib/input.cp";
comptime import "stdlib:/graphics/raylib/gestures.cp";
comptime import "stdlib:/graphics/raylib/camera.cp";
comptime import "stdlib:/graphics/raylib/draw.cp";
comptime import "stdlib:/graphics/raylib/shapes.cp";
comptime import "stdlib:/graphics/raylib/textures.cp";
comptime import "stdlib:/graphics/raylib/text.cp";
comptime import "stdlib:/graphics/raylib/models.cp";
comptime import "stdlib:/graphics/raylib/audio.cp";
comptime import "stdlib:/graphics/raylib/resources.cp";
comptime import "stdlib:/graphics/raylib/math.cp";
comptime import "stdlib:/graphics/raylib/low_level.cp";

#endif
