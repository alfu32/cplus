{
  "name": "cplus-language-support",
  "displayName": "C-plus Language Support",
  "description": "Syntax highlighting, completion, and lightweight IntelliSense for C-plus.",
  "version": "0.1.0",
  "publisher": "cplus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/c-plus/c-plus"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cplus"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cplus",
        "aliases": ["C-plus", "cplus"],
        "extensions": [".cp", ".c+"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cplus",
        "scopeName": "source.cplus",
        "path": "./syntaxes/cplus.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cplus-file-icons",
        "label": "C-plus File Icons",
        "path": "./icons/cplus-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "cplus.transcode",
        "title": "C-plus: Transcode Current File"
      },
      {
        "command": "cplus.compile",
        "title": "C-plus: Compile Current File"
      },
      {
        "command": "cplus.run",
        "title": "C-plus: Run Current File"
      },
      {
        "command": "cplus.check",
        "title": "C-plus: Check Current File"
      }
    ],
    "configuration": {
      "title": "C-plus",
      "properties": {
        "cplus.compilerCommand": {
          "type": "string",
          "default": "cplus",
          "description": "C-plus CLI command used by compiler-backed checks and build commands."
        },
        "cplus.compilerArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to the C-plus CLI compiler."
        },
        "cplus.compilerDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Run the C-plus compiler on save and map diagnostics back to the .cp file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/smoke.js",
    "package": "npm run compile && node scripts/package.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.7.3"
  }
}
