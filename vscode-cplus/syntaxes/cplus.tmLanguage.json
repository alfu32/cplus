{
  "name": "C-plus",
  "scopeName": "source.cplus",
  "fileTypes": ["cp", "c+"],
  "patterns": [
    {"include": "#comments"},
    {"include": "#preprocessor"},
    {"include": "#strings"},
    {"include": "#comptime"},
    {"include": "#special-identifiers"},
    {"include": "#annotations"},
    {"include": "#keywords"},
    {"include": "#functions"},
    {"include": "#types"},
    {"include": "#numbers"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.c", "match": "//.*$"},
        {"name": "comment.block.c", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "preprocessor": {
      "patterns": [
        {"name": "meta.preprocessor.c", "match": "^\\s*#.*$"}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.quoted.double.c", "begin": "\"", "end": "\""},
        {"name": "string.quoted.single.c", "begin": "'", "end": "'"}
      ]
    },
    "comptime": {
      "patterns": [
        {"name": "meta.directive.comptime-flags.cplus", "match": "\\bcomptime\\s+flags\\b"},
        {"name": "keyword.control.comptime.cplus", "match": "\\b(comptime|type|variable|function|import|code|test|var|fn|defer|string)\\b"},
        {"name": "keyword.control.comptime.cplus", "match": "@(?=\\s*\\{)"},
        {"name": "keyword.control.comptime.cplus", "match": "@(import|if|else|for|type|var|fn|code|test)\\b"},
        {"name": "support.function.builtin.cplus", "match": "@(assertEquals|assert|throws|try|catch)\\b"},
        {"name": "support.function.builtin.cplus", "match": "\\b(CPLUS_TEST_ASSERT_EQUALS|CPLUS_TEST_ASSERT|CPLUS_TEST_FAIL)\\b"},
        {"name": "entity.name.function.comptime.splice.cplus", "match": "@[A-Za-z_]\\w*(?=\\s*\\([^()]*\\)(?:[A-Za-z_]|\\())"},
        {"name": "entity.name.function.comptime.cplus", "match": "@[A-Za-z_]\\w*"},
        {"name": "variable.language.comptime.cplus", "match": "\\bos\\b"},
        {"name": "variable.other.comptime.property.cplus", "match": "\\.(name|size|align|fields|type)\\b"}
      ]
    },
    "special-identifiers": {
      "patterns": [
        {"name": "variable.language.self.cplus", "match": "\\bself\\b"}
      ]
    },
    "annotations": {
      "patterns": [
        {"name": "storage.modifier.annotation.cplus", "match": "\\b(pub|priv|mut|borrowed|owned|stat|static|scratch|hot|warm|cold)\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.c", "match": "\\b(auto|break|case|continue|default|do|else|for|goto|if|return|sizeof|switch|while)\\b"},
        {"name": "storage.type.c", "match": "\\b(char|const|double|enum|extern|float|inline|int|long|register|restrict|short|signed|static|struct|typedef|union|unsigned|void|volatile)\\b"},
        {"name": "storage.type.c", "match": "\\b(_Alignas|_Alignof|_Atomic|_Bool|_Complex|_Generic|_Imaginary|_Noreturn|_Static_assert|_Thread_local|bool|size_t|ptrdiff_t|wchar_t|char16_t|char32_t)\\b"}
      ]
    },
    "functions": {
      "patterns": [
        {"name": "entity.name.function.cplus", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "entity.name.type.struct.cplus", "match": "\\b[A-Za-z_]\\w*_t\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.c", "match": "\\b(0[xX][0-9A-Fa-f]+|[0-9]+(\\.[0-9]*)?)\\b"}
      ]
    }
  }
}
